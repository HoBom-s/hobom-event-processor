HOBOM_GRPC_ADDR=dev-for-hobom-backend:50051
HOBOM_GRPC_API_KEY=your-grpc-api-key-here
HOBOM_KAFKA_BROKER=kafka:9092
HOBOM_REDIS_ADDR=redis:6379
HOBOM_SPACE_GRPC_ADDR=dev-hobom-space-backend:50052
# for-hobom-angel-backend outbox (angel + angel-log pollers). Leave unset to
# skip. HOBOM_ANGEL_GRPC_API_KEY must equal the backend's HOBOM_GRPC_API_KEY.
HOBOM_ANGEL_GRPC_ADDR=dev-for-hobom-angel-backend:50051
HOBOM_ANGEL_GRPC_API_KEY=your-angel-grpc-api-key-here
HOBOM_INTERNAL_API_KEY=your-internal-api-key-here
HOBOM_GRPC_TLS_CERT=
